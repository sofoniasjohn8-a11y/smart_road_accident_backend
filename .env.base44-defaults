# Development placeholders for the Base44 sandbox. Committed on purpose: they let the
# app boot with no credentials. Each service lists this file FIRST in its env_file, so
# real secrets delivered to /run/base44/app.env always override these values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://road_safety:road_safety_dev_password@postgres:5432/road_safety
DATABASE_SSL=false
JWT_EXPIRES_IN=8h
# Local-only simulated-device secret (>=32 chars). Replace per device in real deployments.
DEVICE_API_KEYS={"ROAD_DEVICE_001":"h9g2KOOgQFjEWScYgbjRD6q0oYHxZwhgB1bBDGF-6Xc"}
DEVICE_SIGNATURE_TOLERANCE_SECONDS=300
# Firebase Cloud Messaging is optional; without these the API runs with notifications disabled.
GOOGLE_APPLICATION_CREDENTIALS=
FCM_TOKEN_ENCRYPTION_KEY=
