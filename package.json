{
  "name": "smart-road-accident-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Academic prototype backend for smart road accident detection and emergency response",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "worker:create": "node scripts/create-worker.js",
    "test": "node --test",
    "test:integration": "node --test test/accidents.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
