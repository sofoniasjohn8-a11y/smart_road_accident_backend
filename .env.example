NODE_ENV=development
PORT=3000
# Local example: postgres://postgres:your_local_password@localhost:5432/road_safety
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/road_safety
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
# JSON object mapping device IDs to unique random secrets. Never commit real secrets.
DEVICE_API_KEYS={"ROAD_DEVICE_001":"REPLACE_WITH_A_LONG_RANDOM_DEVICE_SECRET"}
DEVICE_SIGNATURE_TOLERANCE_SECONDS=300
CORS_ORIGINS=http://localhost:3000
# Proxy hops in front of the API. Set to 1 when a load balancer or reverse proxy
# sets X-Forwarded-For (Render does); leave 0 when the API is exposed directly.
TRUST_PROXY_HOPS=0
# Optional: absolute path to a backend-only Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FCM_TOKEN_ENCRYPTION_KEY=
